  BankAccountRemittanceEmails BankAccountRemittanceEmails[]
  PaymentProcessing           PaymentProcessing[]

  @@index([EntityId], map: "IX_BankAccountInfos_EntityId")
  @@schema("public")
}

model BankAccountRemittanceEmails {
  Id                String           @id(map: "PK_BankAccountRemittanceEmails") @db.Uuid
  Email             String?
  BankAccountInfoId String           @db.Uuid
  CreatedAt         DateTime         @db.Timestamptz(6)
  UpdatedAt         DateTime?        @db.Timestamptz(6)
  DeletedAt         DateTime?        @db.Timestamptz(6)
  IsDeleted         Boolean
  IsEnabled         Boolean          @default(true)
  BankAccountInfos  BankAccountInfos @relation(fields: [BankAccountInfoId], references: [Id], onDelete: Cascade, onUpdate: NoAction, map: "FK_BankAccountRemittanceEmails_BankAccountInfos_BankAccountInf~")

  @@index([BankAccountInfoId], map: "IX_BankAccountRemittanceEmails_BankAccountInfoId")
  @@schema("public")
}

model BellNotifications {
  Id        String    @id(map: "PK_BellNotifications") @db.Uuid
  IsRead    Boolean
  OrderId   String    @unique(map: "IX_BellNotifications_OrderId") @db.Uuid
  Name      String?
  CreatedAt DateTime  @db.Timestamptz(6)
  UpdatedAt DateTime? @db.Timestamptz(6)
  DeletedAt DateTime? @db.Timestamptz(6)
  IsDeleted Boolean
  IsEnabled Boolean
  Orders    Orders    @relation(fields: [OrderId], references: [Id], onDelete: Cascade, onUpdate: NoAction, map: "FK_BellNotifications_Orders_OrderId")

  @@schema("public")
}

model BillableItems {
  Id                   String                 @id(map: "PK_BillableItems") @db.Uuid
  ShortDescription     String?
  LongDescription      String?
  Description          String?
  Hcpcs                String?
  Mod1                 String?
  Mod2                 String?
  Mod3                 String?
  Mod4                 String?
  AttributeType        Int
