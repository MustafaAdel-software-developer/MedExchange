  UpdatedAt          DateTime?            @db.Timestamptz(6)
  DeletedAt          DateTime?            @db.Timestamptz(6)
  IsDeleted          Boolean
  IsEnabled          Boolean
  BillableItems      BillableItems        @relation(fields: [BillableItemId], references: [Id], onUpdate: NoAction, map: "FK_BillableItemsHistory_BillableItems_BillableItemId")
