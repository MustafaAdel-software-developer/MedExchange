  Entity               Entity                 @relation(fields: [EntityId], references: [Id], onDelete: Cascade, onUpdate: NoAction, map: "FK_BillableItems_Entity_EntityId")
  BillableItemsHistory BillableItemsHistory[]
  ServiceBillableItems ServiceBillableItems[]

  @@unique([EntityId, Hcpcs, Mod1, Mod2, Mod3, Mod4, AttributeType, AttributeTypeValue], map: "IX_BillableItems_EntityId_Hcpcs_Mod1_Mod2_Mod3_Mod4_AttributeT~")
  @@index([CptCodeId], map: "IX_BillableItems_CptCodeId")
