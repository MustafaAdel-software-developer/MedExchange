  Mod2               String?
  Mod3               String?
  Mod4               String?
  AttributeType      Int
  AttributeTypeValue String?
  ChargeAmount       Decimal              @db.Decimal
  Classification     Int                  @default(1)
  DefaultUnits       Int
  EntityId           String               @db.Uuid
