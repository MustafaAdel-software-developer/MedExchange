generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["identity", "public"]
}

model RefreshTokens {
  Id                String   @id(map: "PK_RefreshTokens") @db.Uuid
  ApplicationUserId String?
  Token             String?
  JwtId             String?
  IsUsed            Boolean
  IsRevoked         Boolean
  CreatedAt         DateTime @db.Timestamptz(6)
  ExpiresAt         DateTime @db.Timestamptz(6)
  IsEnabled         Boolean

  @@schema("identity")
}

model RoleClaims {
  Id         Int     @id(map: "PK_RoleClaims") @default(autoincrement())
  RoleId     String
  ClaimType  String?
  ClaimValue String?
  Roles      Roles   @relation(fields: [RoleId], references: [Id], onDelete: Cascade, onUpdate: NoAction, map: "FK_RoleClaims_Roles_RoleId")

  @@index([RoleId], map: "IX_RoleClaims_RoleId")
  @@schema("identity")
}

model Roles {
  Id               String       @id(map: "PK_Roles")
  IsDeleted        Boolean
  CreatedAt        DateTime     @db.Timestamptz(6)
  UpdatedAt        DateTime?    @db.Timestamptz(6)
  DeletedAt        DateTime?    @db.Timestamptz(6)
  IsEnabled        Boolean
  Name             String?      @db.VarChar(256)
  NormalizedName   String?      @unique(map: "RoleNameIndex") @db.VarChar(256)
  ConcurrencyStamp String?
  RoleClaims       RoleClaims[]
  UserRoles        UserRoles[]

  @@schema("identity")
}

model UserClaims {
  Id         Int     @id(map: "PK_UserClaims") @default(autoincrement())
  UserId     String
  ClaimType  String?
  ClaimValue String?
  Users      Users   @relation(fields: [UserId], references: [Id], onDelete: Cascade, onUpdate: NoAction, map: "FK_UserClaims_Users_UserId")

  @@index([UserId], map: "IX_UserClaims_UserId")
  @@schema("identity")
}

model UserLogins {
  LoginProvider       String
  ProviderKey         String
  ProviderDisplayName String?
  UserId              String
  Users               Users   @relation(fields: [UserId], references: [Id], onDelete: Cascade, onUpdate: NoAction, map: "FK_UserLogins_Users_UserId")

  @@id([LoginProvider, ProviderKey], map: "PK_UserLogins")
  @@index([UserId], map: "IX_UserLogins_UserId")
  @@schema("identity")
}

model UserRoles {
  UserId    String
  RoleId    String
  EntityId  String    @unique(map: "IX_UserRoles_EntityId") @db.Uuid
  IsDeleted Boolean
  CreatedAt DateTime  @db.Timestamptz(6)
  UpdatedAt DateTime? @db.Timestamptz(6)
  DeletedAt DateTime? @db.Timestamptz(6)
  IsEnabled Boolean
  Entity    Entity    @relation(fields: [EntityId], references: [Id], onDelete: Cascade, onUpdate: NoAction, map: "FK_UserRoles_Entity_EntityId")
  Roles     Roles     @relation(fields: [RoleId], references: [Id], onDelete: Cascade, onUpdate: NoAction, map: "FK_UserRoles_Roles_RoleId")
  Users     Users     @relation(fields: [UserId], references: [Id], onDelete: Cascade, onUpdate: NoAction, map: "FK_UserRoles_Users_UserId")

  @@id([UserId, RoleId, EntityId], map: "PK_UserRoles")
  @@index([RoleId], map: "IX_UserRoles_RoleId")
  @@schema("identity")
}

model UserTokens {
  UserId        String
  LoginProvider String
  Name          String
  Value         String?
  Users         Users   @relation(fields: [UserId], references: [Id], onDelete: Cascade, onUpdate: NoAction, map: "FK_UserTokens_Users_UserId")

  @@id([UserId, LoginProvider, Name], map: "PK_UserTokens")
  @@schema("identity")
}

model Users {
  Id                           String              @id(map: "PK_Users")
  FirstName                    String?
  MiddleName                   String?
  LastName                     String?
  Suffix                       String?
  DateOfBirth                  DateTime            @db.Timestamptz(6)
  Gender                       Int
  IsAdmin                      Boolean
  IsDeleted                    Boolean
  CreatedAt                    DateTime            @db.Timestamptz(6)
  UpdatedAt                    DateTime?           @db.Timestamptz(6)
  DeletedAt                    DateTime?           @db.Timestamptz(6)
  IsEnabled                    Boolean
  ExpiresAllTokensIssuedBefore DateTime?           @db.Timestamptz(6)
  UserImage                    String?             @db.Uuid
  CustomerId                   String?
  ConnectionId                 String?
  VerificationCode             String?
  VerificationCodeCreatedAt    DateTime            @db.Timestamptz(6)
  ReceiveSmsMessages           Boolean
  TwilioOptedIn                Boolean
  PinCode                      String?
  UserName                     String?             @db.VarChar(256)
  NormalizedUserName           String?             @unique(map: "UserNameIndex") @db.VarChar(256)
  Email                        String?             @db.VarChar(256)
  NormalizedEmail              String?             @db.VarChar(256)
  EmailConfirmed               Boolean
  PasswordHash                 String?
  SecurityStamp                String?
  ConcurrencyStamp             String?
  PhoneNumber                  String?
  PhoneNumberConfirmed         Boolean
  TwoFactorEnabled             Boolean
  LockoutEnd                   DateTime?           @db.Timestamptz(6)
  LockoutEnabled               Boolean
  AccessFailedCount            Int
  UserClaims                   UserClaims[]
  UserLogins                   UserLogins[]
  UserRoles                    UserRoles[]
  UserTokens                   UserTokens[]
  EntityUsers                  EntityUsers[]
  Identifications              Identifications[]
  Invitations                  Invitations[]
  JoiningRequests              JoiningRequests?
  RegisterationCode            RegisterationCode?
  UserNotifications            UserNotifications[]

  @@index([NormalizedEmail], map: "EmailIndex")
  @@schema("identity")
}

model Addresses {
  Id         String       @id(map: "PK_Addresses") @db.Uuid
  LineOne    String?
  LineTwo    String?
  State      String?
  City       String
  ZipCode    String?
  CreatedAt  DateTime     @db.Timestamptz(6)
  UpdatedAt  DateTime?    @db.Timestamptz(6)
  DeletedAt  DateTime?    @db.Timestamptz(6)
  IsDeleted  Boolean
  IsEnabled  Boolean
  GlobalInfo GlobalInfo[]
  Locations  Locations[]

  @@schema("public")
}

model AssignTaxonomies {
  Id              String          @id(map: "PK_AssignTaxonomies") @db.Uuid
  IsPrimary       Boolean         @default(false)
  TaxonomyId      Int
  IdentifierId    String          @db.Uuid
  CreatedAt       DateTime        @db.Timestamptz(6)
  UpdatedAt       DateTime?       @db.Timestamptz(6)
  DeletedAt       DateTime?       @db.Timestamptz(6)
  IsDeleted       Boolean
  IsEnabled       Boolean
  Identifications Identifications @relation(fields: [IdentifierId], references: [Id], onDelete: Cascade, onUpdate: NoAction, map: "FK_AssignTaxonomies_Identifications_IdentifierId")
  Taxonomies      Taxonomies      @relation(fields: [TaxonomyId], references: [Key], onDelete: Cascade, onUpdate: NoAction, map: "FK_AssignTaxonomies_Taxonomies_TaxonomyId")

  @@index([IdentifierId], map: "IX_AssignTaxonomies_IdentifierId")
  @@index([TaxonomyId], map: "IX_AssignTaxonomies_TaxonomyId")
  @@schema("public")
}

model AuditLogs {
  Id         String   @id(map: "PK_AuditLogs") @db.Uuid
  UserId     String?
  Username   String?
  EntityName String?
  Action     String?
  Timestamp  DateTime @db.Timestamptz(6)
  Values     String?
  Changes    String?

  @@schema("public")
}

model BankAccountInfos {
  Id                          String                        @id(map: "PK_BankAccountInfos") @db.Uuid
  BankName                    String?
  BankAccountNumber           String?
  RoutingNumber               String?
