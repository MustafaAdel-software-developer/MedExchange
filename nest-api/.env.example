# Server
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/medexchange?schema=public

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_ISSUER=https://localhost:3000
JWT_AUDIENCE=https://localhost:3000
JWT_EXPIRY_MINUTES=120

# Frontend (invite / payment / email links)
FRONTEND_URL=http://localhost:5173

# SMTP (optional — unset logs emails in dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=false

# OAuth (optional)
GOOGLE_CLIENT_ID=
MICROSOFT_CLIENT_ID=

# Stripe (optional — unset uses stub checkout sessions)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
